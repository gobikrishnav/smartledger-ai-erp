# ==============================================================================
# SmartLedger AI ERP — MongoDB Atlas Cloud & Production Environment Template
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas Cloud Connection String:
# Replace <username>, <password>, and <cluster-url> with your free MongoDB Atlas details:
# Example: mongodb+srv://admin_user:MySecurePass123@cluster0.abcde.mongodb.net/smartledger_erp?retryWrites=true&w=majority
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smartledger_erp?retryWrites=true&w=majority
# Fallback alias supported:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smartledger_erp?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Security & Authentication
# Generate any 32+ character random string for production JWT signing
# ------------------------------------------------------------------------------
JWT_SECRET=production_super_secret_jwt_key_2026_smartledger_erp

# ------------------------------------------------------------------------------
# 3. Clean Brand New Slate Mode:
# When true, the app boots clean without demo invoices or dummy companies,
# allowing the business owner to start fresh and input their own business info.
# ------------------------------------------------------------------------------
START_CLEAN=true
AUTO_SEED=false

# ------------------------------------------------------------------------------
# 4. Optional AI Microservice (Leave commented out to use high-speed Native JS AI)
# ------------------------------------------------------------------------------
# AI_SERVICE_URL=http://localhost:8000
